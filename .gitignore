# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.installed.cfg
*.egg

# Virtual envs / secrets
.env
.env.*
!.env.example
!.env.*.example
.venv
venv/
ENV/

# Sepolia deployment output (public addresses, no secrets). Tracked in Git
# so the TFM can reference the specific deployed contracts and any reader
# can verify them on sepolia.etherscan.io. A re-deploy would produce NEW
# addresses (non-deterministic), so tracking is the only way to preserve
# provenance for the writeup.
!deployments/*.json

# Campaign secrets — PRIVATE KEYS + mixer notes. Enable sweep + mixer
# recovery. NEVER commit any of these; they are per-run and per-machine.
**/wallets_keys.json
**/wallets_keys.jsonl
**/mixer_notes.jsonl
**/sub_agent_transcripts.json
# Mixer recovery logs contain deposit notes (secret + nullifier) in plaintext.
results/mixer_recovery_logs/

# Conda
.conda/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Data — large, regenerable
data/elliptic/*
data/amlworld/*
data/ethereum/*
data/tron/*
!data/*/.gitkeep
*.csv
*.parquet
*.h5
*.npz
# Combined dataset pickles (regenerable via scripts/load_ethereum_heist.py etc.)
*.pkl
*.pickle

# Price cache is small + reproducibility-critical, keep it tracked
!data/prices/
!data/prices/*.csv

# Model checkpoints
*.pt
*.pth
*.ckpt
checkpoints/

# Experiment tracking
wandb/
mlruns/
lightning_logs/
outputs/

# Results — keep summary jsons but ignore raw episodes
results/raw/
results/episodes/
!results/.gitkeep

# Foundry
/out/
/cache/
/broadcast/
/lib/

# Circom / snarkjs build artifacts (regenerable via scripts/setup_zk.sh)
/circuits/build/
/circuits/ptau/
/node_modules/

# Auto-generated Solidity Groth16 verifier (per-setup, regenerated by
# scripts/setup_zk.sh withdraw — different developers produce different
# verifiers from their local trusted-setup contributions)
/contracts/Verifier.sol

# Allow examples
!.env.example

# Coordinator checkpoints and incremental sub-agent logs embed mixer deposit notes (secret + nullifier)
**/coordinator_checkpoint.json
**/sub_agents_incremental.jsonl
