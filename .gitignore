# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.installed.cfg
*.egg

# Virtual envs / secrets
.env
.env.*
!.env.example
!.env.*.example
.venv
venv/
ENV/

# Sepolia deployment output (contains addresses, no secrets — but
# regenerable by rerunning scripts/deploy_eth_mocks_sepolia.py)
deployments/*.json
!deployments/.gitkeep

# Conda
.conda/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Data — large, regenerable
data/elliptic/*
data/amlworld/*
data/ethereum/*
data/tron/*
!data/*/.gitkeep
*.csv
*.parquet
*.h5
*.npz
# Combined dataset pickles (regenerable via scripts/load_ethereum_heist.py etc.)
*.pkl
*.pickle

# Price cache is small + reproducibility-critical, keep it tracked
!data/prices/
!data/prices/*.csv

# Model checkpoints
*.pt
*.pth
*.ckpt
checkpoints/

# Experiment tracking
wandb/
mlruns/
lightning_logs/
outputs/

# Results — keep summary jsons but ignore raw episodes
results/raw/
results/episodes/
!results/.gitkeep

# Foundry
/out/
/cache/
/broadcast/
/lib/

# Circom / snarkjs build artifacts (regenerable via scripts/setup_zk.sh)
/circuits/build/
/circuits/ptau/
/node_modules/

# Auto-generated Solidity Groth16 verifier (per-setup, regenerated by
# scripts/setup_zk.sh withdraw — different developers produce different
# verifiers from their local trusted-setup contributions)
/contracts/Verifier.sol

# Allow examples
!.env.example
