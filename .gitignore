# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.installed.cfg
*.egg

# Virtual envs / secrets
.env
.venv
venv/
ENV/

# Conda
.conda/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Data — large, regenerable
data/elliptic/*
data/amlworld/*
data/ethereum/*
data/tron/*
!data/*/.gitkeep
*.csv
*.parquet
*.h5
*.npz

# Price cache is small + reproducibility-critical, keep it tracked
!data/prices/
!data/prices/*.csv

# Model checkpoints
*.pt
*.pth
*.ckpt
checkpoints/

# Experiment tracking
wandb/
mlruns/
lightning_logs/
outputs/

# Results — keep summary jsons but ignore raw episodes
results/raw/
results/episodes/
!results/.gitkeep

# Foundry
/out/
/cache/
/broadcast/
/lib/

# Circom / snarkjs build artifacts (regenerable via scripts/setup_zk.sh)
/circuits/build/
/circuits/ptau/
/node_modules/

# Allow examples
!.env.example
