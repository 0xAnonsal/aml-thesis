# .env.sepolia — populate then rename to .env.sepolia
#
# CRITICAL: .env.sepolia is gitignored. NEVER commit it. NEVER paste the
# SEPOLIA_DEPLOYER_PRIVATE_KEY into chat, logs, screenshots, or issues.
# The private key controls the deployer wallet. Even on testnet, treat it
# like a mainnet key so you build the right muscle memory.

# ----- Sepolia RPC endpoint -----
# Free options:
#   Alchemy:  https://eth-sepolia.g.alchemy.com/v2/<YOUR_API_KEY>
#   Infura:   https://sepolia.infura.io/v3/<YOUR_PROJECT_ID>
#   Public:   https://ethereum-sepolia-rpc.publicnode.com  (rate-limited, ok for smoke tests)
SEPOLIA_RPC_URL=

# ----- Deployer wallet private key (64 hex chars, no 0x prefix required) -----
# Export from MetaMask: click account -> Account details -> Show private key
# Must control the address expected by the TFM: 0x54539B5ef33cfC3C57b9b572fc77d1e5F1CFf4c4
SEPOLIA_DEPLOYER_PRIVATE_KEY=

# ----- Etherscan API key (optional but recommended for source-code verify) -----
# https://etherscan.io/myapikey (single key works for all networks incl. Sepolia)
ETHERSCAN_API_KEY=
