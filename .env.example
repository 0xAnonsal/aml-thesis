# ----- LLM APIs -----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=                              # optional, for GPT-4 comparison runs

# ----- Blockchain data -----
ETHERSCAN_API_KEY=                           # https://etherscan.io/apis
ALCHEMY_API_KEY=                             # https://www.alchemy.com  (Ethereum RPC)
TRONGRID_API_KEY=                            # https://www.trongrid.io  (Tron data)

# ----- Local Ethereum fork (Anvil / Hardhat) -----
ETHEREUM_FORK_RPC_URL=http://localhost:8545
ETHEREUM_FORK_BLOCK=latest

# ----- Experiment tracking -----
WANDB_API_KEY=
WANDB_PROJECT=aml-thesis
WANDB_ENTITY=

# ----- LangSmith (optional, LLM trace debugging) -----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aml-thesis
